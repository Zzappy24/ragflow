# syntax=docker/dockerfile:1.6

# =============================================================================
#  Dockerfile.management — slim image for the custom B2B SaaS admin backend.
#  Builds an isolated image (~250 MB) that does NOT include torch, CUDA,
#  rag/, deepdoc/, nginx, or the main RAGFlow frontend.
#
#  Custom (does not exist upstream). Built and deployed separately from
#  the main ragflow image (which stays heavy because task_executor needs
#  GPU + OCR libraries).
#
#  Image identifier: ${REGISTRY}/data/ragflow-mgmt:${TAG}
# =============================================================================

# --- builder stage ----------------------------------------------------------
FROM python:3.13-slim AS builder

ARG DEBIAN_FRONTEND=noninteractive

# gcc + libc6-dev are needed by some wheels (cryptography, pycryptodomex)
# during the install step. They're discarded in the production stage.
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libc6-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Install only the deps the management backend actually needs. Versions
# pinned to match pyproject.toml of the main ragflow image so a service
# upgraded on either side stays compatible.
RUN python -m venv /opt/venv && \
    /opt/venv/bin/pip install --no-cache-dir --upgrade pip && \
    /opt/venv/bin/pip install --no-cache-dir \
        "fastapi>=0.110.0" \
        "uvicorn[standard]>=0.29.0" \
        "pydantic-settings>=2.2.0" \
        "PyJWT>=2.8.0" \
        "httpx>=0.27.0" \
        "peewee>=3.17.1,<4.0.0" \
        "mysql-connector-python>=9.0.0,<10.0.0" \
        "psycopg2-binary>=2.9.11,<3.0.0" \
        "pycryptodomex==3.20.0" \
        "Werkzeug>=3.0.0" \
        "python-dateutil>=2.8.0" \
        "PyYAML>=6.0.0"

# --- production stage -------------------------------------------------------
FROM python:3.13-slim AS production

ARG VERSION_INFO=dev
LABEL org.opencontainers.image.title="ragflow-management" \
      org.opencontainers.image.description="Cyllene B2B SaaS admin backend (RBAC, workspaces, organizations) — custom fork" \
      org.opencontainers.image.version="${VERSION_INFO}"

# Runtime-only system libs (no compilers).
# libpq5 is required by psycopg2-binary at runtime, even though the wheel
# is precompiled — the wheel dynamically links to libpq.so.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -r ragflow && useradd -r -g ragflow -d /ragflow -m -s /bin/bash ragflow

WORKDIR /ragflow

# Pre-built venv from the builder stage.
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}" \
    VIRTUAL_ENV="/opt/venv" \
    PYTHONPATH="/ragflow" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Copy only what management/server/main.py needs to import.
# Keep this list minimal — every package added is a potential bug surface
# and breaks the "no torch / no rag / no deepdoc" guarantee.
COPY --chown=ragflow:ragflow api/__init__.py /ragflow/api/__init__.py
COPY --chown=ragflow:ragflow api/db /ragflow/api/db
COPY --chown=ragflow:ragflow api/utils /ragflow/api/utils
COPY --chown=ragflow:ragflow api/common /ragflow/api/common
COPY --chown=ragflow:ragflow api/constants.py /ragflow/api/constants.py
COPY --chown=ragflow:ragflow api/settings.py /ragflow/api/settings.py
COPY --chown=ragflow:ragflow common /ragflow/common
COPY --chown=ragflow:ragflow management /ragflow/management

# Dev RSA keys + config template. In prod the keys are overridden by a K8s
# secret mount; this gives a working default so the import of api.utils.crypt
# (which loads the keys at module top level) succeeds at boot. The
# service_conf.yaml.template lives under docker/ upstream — the Helm chart
# renders it into /ragflow/conf/local.service_conf.yaml via initContainer.
COPY --chown=ragflow:ragflow conf/private.pem conf/public.pem /ragflow/conf/
COPY --chown=ragflow:ragflow docker/service_conf.yaml.template /ragflow/conf/service_conf.yaml.template

# Drop privileges.
USER ragflow

EXPOSE 8000

# Lightweight healthcheck — relies on FastAPI's auto-generated /openapi.json
# which is always available regardless of which routers are loaded. If the
# admin app has a real /api/v1/health endpoint, prefer pointing the Helm
# readinessProbe at it instead.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import httpx,sys; r=httpx.get('http://127.0.0.1:8000/openapi.json',timeout=3); sys.exit(0 if r.status_code==200 else 1)" || exit 1

# Default command — the Helm chart overrides this with its own uvicorn args,
# so this is mostly for `docker run` smoke tests.
CMD ["uvicorn", "management.server.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--loop", "uvloop", \
     "--http", "httptools", \
     "--no-access-log"]
